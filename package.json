{
  "name": "shift-happens",
  "overrides": {
    "bson": "7.2.0"
  },
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@mit-sdg/sync-engine": "1.1.0",
    "@mit-sdg/sync-engine-http": "1.1.0",
    "mongodb": "^7.9.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "playwright": "1.62.1",
    "typescript": ">=6 <7",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  },
  "scripts": {
    "generate": "sync-engine artifacts pin",
    "check": "sync-engine check && sync-engine artifacts check && tsc --noEmit && bun run check:frontend",
    "check:types": "tsc --noEmit",
    "check:frontend": "vue-tsc --noEmit -p web/tsconfig.json",
    "start": "bun src/main.ts",
    "check:design": "sync-engine check-design design/concepts/*.md design/types.md design/compositions/*.md",
    "test:browser": "bun tests/browser/alpha.smoke.ts",
    "dev": "bun run db:up && bun run --parallel dev:backend dev:frontend",
    "dev:backend": "bun --watch src/main.ts",
    "dev:frontend": "bun --bun vite --config web/vite.config.ts",
    "build": "bun run build:frontend",
    "build:frontend": "bun run check:frontend && bun --bun vite build --config web/vite.config.ts",
    "db:up": "podman compose up -d mongo && bun run db:check --wait",
    "db:down": "podman compose down",
    "db:check": "bun scripts/check-db.ts",
    "db:shell": "podman compose exec mongo mongosh -u dev -p dev",
    "db:logs": "podman compose logs mongo",
    "db:reset": "podman compose down -v"
  }
}
